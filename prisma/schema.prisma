generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditAction {
  ORG_CREATED
  WORKSPACE_CREATED
  BOT_CREATED
  BOT_UPDATED
  BOT_ARCHIVED
  LEAD_CREATED
  ROUTE_LINK_UPDATED
  DOMAIN_ALLOWLIST_UPDATED
}

enum BotStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  CLOSED
}

enum BotLinkType {
  BOOKING
  PAYMENT
  CONTACT
  OTHER
}

enum DataEventType {
  TOPIC_DETECTED
  MISSING_DATA
  TRUTH_RESPONSE
  LEAD_CAPTURE_TRIGGERED
  REDIRECT_CLICK
  LEAD_SCORED
  BOOKING_FLOW_EVENT
  BOOKING_SERVICE_SELECTED
  BOOKING_LEAD_CREATED
  BOOKING_LINK_SHOWN
  BOOKING_LINK_CLICKED
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum NotificationType {
  HOT_LEAD
  BOOKING_LINK_CLICK
  LEAD_STATUS_CHANGE
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
  PENDING
}

model Organization {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Step 27 — Clerk organization mapping
  clerkOrganizationId String? @unique

  // Step 38 — Client self-service permission
  allowClientEdits Boolean @default(false)

  // White-label branding fields
  whiteLabelEnabled  Boolean @default(false)
  brandCompanyName   String?
  brandLogoUrl       String?
  brandPrimaryColor  String  @default("#6366f1")
  showPoweredBy      Boolean @default(true)
  customDomain       String? @unique

  // Step 26 — Custom domain DNS verification
  domainVerificationToken   String?
  customDomainStatus        String   @default("none") // none | pending | verified | failed
  customDomainVerifiedAt    DateTime?
  customDomainLastCheckedAt DateTime?
  customDomainFailureReason String?

  // Step 47 — Notification settings
  notificationEnabled    Boolean  @default(false)
  notificationEmails     String[] @default([])
  notifyOnHotLead        Boolean  @default(true)
  notifyOnBookingClick   Boolean  @default(true)

  // Revenue tracking
  averageOrderValue Int?

  workspaces       Workspace[]
  bots             Bot[]
  conversations    Conversation[]
  leads            Lead[]
  auditLogs        AuditLog[]
  dataEvents       DataEvent[]
  members          OrganizationMember[]
  invites          OrganizationInvite[]
  knowledgeSources BotKnowledgeSource[]
  businessProfile   BusinessProfile?
  services          OrganizationService[]
  hours             OrganizationHours[]
  notificationLogs  NotificationLog[]

  @@index([createdAt])
}

model Workspace {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  organizationId Int
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bots          Bot[]
  leads         Lead[]
  conversations Conversation[]
  auditLogs     AuditLog[]
  dataEvents    DataEvent[]

  @@index([organizationId])
  @@index([createdAt])
}

model Bot {
  id             Int       @id @default(autoincrement())
  publicKey      String    @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  organizationId Int
  workspaceId    Int

  name         String
  status       BotStatus @default(ACTIVE)

  greeting     String?
  fallbackText String?

  // Business profile fields
  businessPhone   String?
  businessEmail   String?
  businessAddress String?
  hours           Json?
  services        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  links            BotLink[]
  allowlist        BotDomainAllowlist[]
  leads            Lead[]
  conversations    Conversation[]
  dataEvents       DataEvent[]
  knowledgeSources BotKnowledgeSource[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
}

model BotLink {
  id        Int        @id @default(autoincrement())
  botId     Int
  type      BotLinkType
  label     String
  url       String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([type])
}

model BotDomainAllowlist {
  id        Int      @id @default(autoincrement())
  botId     Int
  domain    String
  createdAt DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, domain])
  @@index([botId])
}

model Conversation {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  organizationId Int
  workspaceId    Int
  botId          Int

  bookingState Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bot          Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)

  messages Message[]
  leads    Lead[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([botId])
  @@index([createdAt])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int

  role      String
  content   String
  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Lead {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  organizationId Int
  workspaceId    Int
  botId          Int
  conversationId Int?
  serviceId      Int?

  status LeadStatus @default(NEW)
  notes  String?

  name    String?
  email   String?
  phone   String?
  answers Json?

  score        Int             @default(0)
  temperature  LeadTemperature @default(COLD)
  scoreReasons Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bot               Bot                   @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversation      Conversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  service           OrganizationService?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  notificationLogs  NotificationLog[]

  @@unique([conversationId, serviceId], name: "Lead_conversationId_serviceId_key")
  @@index([organizationId])
  @@index([workspaceId])
  @@index([botId])
  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([serviceId, createdAt])
  @@index([temperature])
}

model AuditLog {
  id             Int        @id @default(autoincrement())
  organizationId Int
  workspaceId    Int?

  action  AuditAction
  summary String

  actorId String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([createdAt])
}

model DataEvent {
  id       Int           @id @default(autoincrement())
  publicId String        @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))

  organizationId Int
  workspaceId    Int
  botId          Int
  conversationId Int?

  type    DataEventType
  topic   String?
  payload Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bot          Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([botId])
  @@index([conversationId])
  @@index([type])
  @@index([createdAt])
  @@index([organizationId, type, createdAt])
}

model OrganizationMember {
  id             Int      @id @default(autoincrement())
  organizationId Int
  clerkUserId    String
  role           String   // AGENCY_OWNER | AGENCY_ADMIN | CLIENT
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, clerkUserId])
  @@index([clerkUserId])
  @@index([organizationId])
}

model OrganizationInvite {
  id                   Int       @id @default(autoincrement())
  organizationId       Int
  token                String    @unique
  role                 String    // AGENCY_OWNER | AGENCY_ADMIN | CLIENT
  createdByClerkUserId String
  expiresAt            DateTime
  usedAt               DateTime?
  usedByClerkUserId    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
}

model BotKnowledgeSource {
  id             Int      @id @default(autoincrement())
  botId          Int
  organizationId Int

  type        String   // "PASTE" | "URL"
  title       String
  content     String
  contentHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bot          Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([botId, contentHash])
  @@index([botId])
  @@index([organizationId])
}

model BusinessProfile {
  id             Int      @id @default(autoincrement())
  organizationId Int      @unique

  businessName String
  category     String
  phone        String?
  email        String?
  address      String?
  serviceArea  String?
  hours        Json?
  websiteUrl   String?
  bookingUrl   String?
  tone         String   // "professional" | "friendly" | "luxury" | "bold" | "chill"
  primaryGoal  String   // "bookings" | "leads" | "faqs" | "support"

  cancellationPolicy String?
  depositPolicy      String?
  refundPolicy       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model DemoRequest {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  businessName String
  phone        String?
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model OrganizationService {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  priceCents     Int?
  bookingUrl     String?
  paymentUrl     String?
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model OrganizationHours {
  id             Int      @id @default(autoincrement())
  organizationId Int
  dayOfWeek      Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  isClosed       Boolean  @default(false)
  openTime       String?  // "HH:MM" 24h format
  closeTime      String?  // "HH:MM" 24h format
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dayOfWeek])
  @@index([organizationId])
}

model NotificationLog {
  id                Int                @id @default(autoincrement())
  publicId          String             @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  organizationId    Int
  leadId            Int?
  type              NotificationType
  channel           NotificationChannel @default(EMAIL)
  recipientEmail    String
  status            NotificationStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId])
  @@index([createdAt])
  @@index([status])
}
