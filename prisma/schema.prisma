generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditAction {
  ORG_CREATED
  WORKSPACE_CREATED
  BOT_CREATED
  BOT_UPDATED
  BOT_ARCHIVED
  LEAD_CREATED
  ROUTE_LINK_UPDATED
  DOMAIN_ALLOWLIST_UPDATED
}

enum BotStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  CLOSED
}

enum BotLinkType {
  BOOKING
  PAYMENT
  CONTACT
  OTHER
}

model Organization {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces     Workspace[]
  bots           Bot[]
  conversations  Conversation[]
  leads          Lead[]
  auditLogs      AuditLog[]

  @@index([createdAt])
}

model Workspace {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  organizationId Int
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bots          Bot[]
  leads         Lead[]
  conversations Conversation[]
  auditLogs     AuditLog[]

  @@index([organizationId])
  @@index([createdAt])
}

model Bot {
  id             Int       @id @default(autoincrement())
  publicKey      String    @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  organizationId Int
  workspaceId    Int

  name         String
  status       BotStatus @default(ACTIVE)

  greeting     String?
  fallbackText String?

  // Business profile fields
  businessPhone   String?
  businessEmail   String?
  businessAddress String?
  hours           Json?
  services        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  links         BotLink[]
  allowlist     BotDomainAllowlist[]
  leads         Lead[]
  conversations Conversation[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
}

model BotLink {
  id        Int        @id @default(autoincrement())
  botId     Int
  type      BotLinkType
  label     String
  url       String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([type])
}

model BotDomainAllowlist {
  id        Int      @id @default(autoincrement())
  botId     Int
  domain    String
  createdAt DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, domain])
  @@index([botId])
}

model Conversation {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  organizationId Int
  workspaceId    Int
  botId          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bot          Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)

  messages Message[]
  leads    Lead[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([botId])
  @@index([createdAt])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int

  role      String
  content   String
  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Lead {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  organizationId Int
  workspaceId    Int
  botId          Int
  conversationId Int?

  status LeadStatus @default(NEW)

  name    String?
  email   String?
  phone   String?
  answers Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bot          Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([botId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id             Int        @id @default(autoincrement())
  organizationId Int
  workspaceId    Int?

  action  AuditAction
  summary String

  actorId String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([createdAt])
}

model MissingDataEvent {
  id             Int      @id @default(autoincrement())
  organizationId Int
  workspaceId    Int
  botId          Int
  conversationId Int

  topics      String[]
  userMessage String

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([workspaceId])
  @@index([botId])
  @@index([conversationId])
  @@index([createdAt])
}
