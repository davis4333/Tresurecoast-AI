# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tca_dev?schema=public"

# App URL (used for widget embedding and API calls)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication (required for production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Development Auth Bypass (NEVER enable in production)
# DEV_BYPASS_AUTH="true"
# DEV_BOOTSTRAP_CLERK_USER_ID="user_dev_123"
# DEV_BOOTSTRAP_CLERK_ORG_ID="org_dev_123"

# Admin Seed Key (for seeding demo data)
ADMIN_SEED_KEY="your_long_random_string_here"

# Rate Limiting (optional - Upstash Redis)
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_token_here"

# Email Notifications (optional - Resend)
# RESEND_API_KEY="re_..."
# NEXT_PUBLIC_RESEND_CONFIGURED="true"

# Demo Bot Key (for demo page)
# NEXT_PUBLIC_DEMO_BOT_KEY="uuid-of-demo-bot"

# Stripe Billing (REQUIRED for production subscriptions)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# OpenAI (if using AI features)
# OPENAI_API_KEY="sk-..."
