{
  "name": "treasure-coast-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "tsx scripts/preflight.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "preflight": "tsx scripts/preflight.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate-verify": "tsx scripts/db-migrate-and-verify.ts",
    "deploy:check": "pnpm lint && pnpm typecheck && pnpm test:e2e && pnpm build",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.8",
    "@playwright/test": "^1.57.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.90.19",
    "lucide-react": "^0.562.0",
    "next": "^14.2.0",
    "openai": "^4.68.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^17.7.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.17",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "prisma": "^5.11.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
